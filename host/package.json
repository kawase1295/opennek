{
  "name": "opennek",
  "version": "0.1.0",
  "description": "Local network for real Sigfox devices: decode their uplinks from a USB receiver, run Sigfox-compatible callbacks and send downlinks",
  "keywords": [
    "sigfox",
    "lpwan",
    "iot",
    "emulator",
    "sx1262"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawase1295/opennek.git",
    "directory": "host"
  },
  "homepage": "https://github.com/kawase1295/opennek#readme",
  "bugs": "https://github.com/kawase1295/opennek/issues",
  "type": "module",
  "bin": {
    "opennek": "bin/opennek.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node bin/opennek.js --open",
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js && node -e \"require('fs').cpSync('src/ui','dist/ui',{recursive:true})\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build && node -e \"for (const f of ['README.md','README.ja.md','LICENSE']) require('fs').copyFileSync('../'+f,f)\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "serialport": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
