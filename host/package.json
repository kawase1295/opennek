{
  "name": "opennek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts --open",
    "dev": "bun --watch src/index.ts",
    "sim": "bun src/index.ts --sim",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --compile --minify --outfile dist/opennek"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
