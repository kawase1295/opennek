{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenNEK",
  "mainBinaryName": "opennek-desktop",
  "identifier": "io.github.kawase1295.opennek",
  "build": {},
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis"
    ],
    "category": "DeveloperTool",
    "publisher": "kawase1295",
    "homepage": "https://github.com/kawase1295/opennek",
    "shortDescription": "Local network for real Sigfox devices",
    "longDescription": "Decodes the uplinks of real Sigfox devices from a USB receiver, runs Sigfox-compatible callbacks and sends downlinks, with a web UI in its own window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
