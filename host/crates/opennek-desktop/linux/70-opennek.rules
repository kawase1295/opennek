# Installed by the OpenNEK desktop app's .deb: the user logged in at the seat may open the radio
# (XIAO ESP32S3, USB-Serial/JTAG) without joining dialout, and RTL-SDR dongles (RTL2838 / RTL2832U) over USB.
# uaccess is applied by 73-seat-late.rules.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2838", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2832", TAG+="uaccess"
