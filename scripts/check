#!/usr/bin/env bash
# Checks that must pass before merging. CI runs this same script.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"

# The web UI first: the host embeds its build (host/ui/dist)
cd "$root/host/ui"
npm ci
npm run check
npm test
npm run build

# The host; rust-toolchain.toml makes rustup install the pinned toolchain
cd "$root/host"
cargo fmt --check
cargo clippy --all-targets --locked -- -D warnings
cargo test --locked
# The desktop app is left out of default-members (it links webkit2gtk / WebView2), so it is checked on its own
cargo clippy --package opennek-desktop --all-targets --locked -- -D warnings
cargo test --package opennek-desktop --locked

# The LSM100A tools (Node)
cd "$root/tools/lsm"
npm ci
npm run typecheck
npm test

# The firmware's decoder and streamer logic, built natively with zig's clang into a temp dir
cd "$root/firmware"
build="$(mktemp -d)"
trap 'rm -rf "$build"' EXIT
cxx() { uvx --from ziglang python -m ziglang c++ -std=c++17 -O2 "$@"; }
cxx -I lib/SigfoxRx/src test/sigfox_native_test.cpp lib/SigfoxRx/src/*.cpp -o "$build/sigfox_test.exe"
"$build/sigfox_test.exe" "$root/fixtures"
cxx -I lib/RadioStreamer/src test/streamer_native_test.cpp lib/RadioStreamer/src/*.cpp -o "$build/streamer_test.exe"
"$build/streamer_test.exe"
