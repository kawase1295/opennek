#!/usr/bin/env bash
# Checks that must pass before merging. CI runs this same script.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"

# The host; rust-toolchain.toml makes rustup install the pinned toolchain
cd "$root/host"
cargo fmt --check
cargo clippy --all-targets --locked -- -D warnings
cargo test --locked
# The web UI is plain JS embedded in the host
node --test ui/i18n.test.mjs

# The LSM100A tools (Node)
cd "$root/tools/lsm"
npm ci
npm run typecheck
npm test
